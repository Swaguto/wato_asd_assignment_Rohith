<?xml version="1.0" ?>
<robot name="asd_world">
  
  <link name="sim_world"></link>

  <joint name="wall1_joint" type="fixed">
    <origin xyz="0 -15 0"/>
    <parent link="sim_world"/>
    <child link="wall1_link"/>
  </joint>
  <link name="wall1_link">
    <visual>
      <geometry>
        <box size="30 0.5 3.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="wall2_joint" type="fixed">
    <origin xyz="0 15 0"/>
    <parent link="sim_world"/>
    <child link="wall2_link"/>
  </joint>
  <link name="wall2_link">
    <visual>
      <geometry>
        <box size="30 0.5 3.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="wall3_joint" type="fixed">
    <origin xyz="15 0 0"/>
    <parent link="sim_world"/>
    <child link="wall3_link"/>
  </joint>
  <link name="wall3_link">
    <visual>
      <geometry>
        <box size="0.5 30 3.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="wall4_joint" type="fixed">
    <origin xyz="-15 0 0"/>
    <parent link="sim_world"/>
    <child link="wall4_link"/>
  </joint>
  <link name="wall4_link">
    <visual>
      <geometry>
        <box size="0.5 30 3.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="box1_joint" type="fixed">
    <origin xyz="7 -6 0"/>
    <parent link="sim_world"/>
    <child link="box1_link"/>
  </joint>
  <link name="box1_link">
    <visual>
      <geometry>
        <box size="3 3 3.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="box2_joint" type="fixed">
    <origin xyz="-8 6 0"/>
    <parent link="sim_world"/>
    <child link="box2_link"/>
  </joint>
  <link name="box2_link">
    <visual>
      <geometry>
        <box size="3 3 3.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="box3_joint" type="fixed">
    <origin xyz="4 9 0"/>
    <parent link="sim_world"/>
    <child link="box3_link"/>
  </joint>
  <link name="box3_link">
    <visual>
      <geometry>
        <box size="3 3 3.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="box4_joint" type="fixed">
    <origin xyz="9 3 0"/>
    <parent link="sim_world"/>
    <child link="box4_link"/>
  </joint>
  <link name="box4_link">
    <visual>
      <geometry>
        <box size="2 2 3.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="box5_joint" type="fixed">
    <origin xyz="1 -10 0"/>
    <parent link="sim_world"/>
    <child link="box5_link"/>
  </joint>
  <link name="box5_link">
    <visual>
      <geometry>
        <box size="2 2 3.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="cyl1_joint" type="fixed">
    <origin xyz="0 0 0"/>
    <parent link="sim_world"/>
    <child link="cyl1_link"/>
  </joint>
  <link name="cyl1_link">
    <visual>
      <geometry>
        <cylinder radius="3" length="3"/>
      </geometry>
    </visual>
  </link>

  <joint name="cyl2_joint" type="fixed">
    <origin xyz="-7 -7 0"/>
    <parent link="sim_world"/>
    <child link="cyl2_link"/>
  </joint>
  <link name="cyl2_link">
    <visual>
      <geometry>
        <cylinder radius="2" length="3"/>
      </geometry>
    </visual>
  </link>

  
  <joint name="robot_root_joint" type="revolute">
    <origin xyz="0 0 0"/>
    <parent link="sim_world"/>
    <child link="robot"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
  </joint>
  <link name="robot"></link>

  <joint name="chassis_joint" type="fixed">
    <origin xyz="0.5 0 0.4"/>
    <parent link="robot"/>
    <child link="robot/chassis"/>
  </joint>
  <link name="robot/chassis">
    <visual>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
      <material name="blue">
        <ambient>0.0 0.0 1.0 1</ambient>
        <diffuse>0.0 0.0 1.0 1</diffuse>
        <specular>0.0 0.0 1.0 1</specular>
      </material>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="fixed">
    <origin xyz="0 0.6 0.4" rpy="-1.5707 0 0"/>
    <parent link="robot"/>
    <child link="robot/left_wheel"/>
  </joint>
  <link name="robot/left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red">
        <ambient>1.0 0.0 0.0 1</ambient>
        <diffuse>1.0 0.0 0.0 1</diffuse>
        <specular>1.0 0.0 0.0 1</specular>
      </material>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="fixed">
    <origin xyz="0 -0.6 0.4" rpy="-1.5707 0 0"/>
    <parent link="robot"/>
    <child link="robot/right_wheel"/>
  </joint>
  <link name="robot/right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red">
        <ambient>1.0 0.0 0.0 1</ambient>
        <diffuse>1.0 0.0 0.0 1</diffuse>
        <specular>1.0 0.0 0.0 1</specular>
      </material>
    </visual>
  </link>

  <joint name="caster_joint" type="fixed">
    <origin xyz="1.3 0 0.2"/>
    <parent link="robot"/>
    <child link="robot/caster"/>
  </joint>
  <link name="robot/caster">
    <visual>
      <geometry>
        <sphere radius="0.2"/>
      </geometry>
      <material name="green">
        <ambient>0.0 1.0 0.0 1</ambient>
        <diffuse>0.0 1.0 0.0 1</diffuse>
        <specular>0.0 1.0 0.0 1</specular>
      </material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.8 0 0.5"/>
    <parent link="robot/chassis"/>
    <child link="robot/chassis/lidar"/>
  </joint>
  <link name="robot/chassis/lidar"/>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.8 0 0.5"/>
    <parent link="robot/chassis"/>
    <child link="robot/chassis/camera"/>
  </joint>
  <link name="robot/chassis/camera"/>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0"/>
    <parent link="robot/chassis"/>
    <child link="robot/chassis/imu_sensor"/>
  </joint>
  <link name="robot/chassis/imu_sensor"/>
</robot>
